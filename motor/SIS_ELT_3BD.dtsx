      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\Registrar_Error"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:DisableEventHandlers="True"
          DTS:DTSID="{0ACD9BE2-37B7-4B49-9374-3A0D6633A8B3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Registrar_Error"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"DECLARE @Lote uniqueidentifier='" + @[User::IdLote] + "'; DECLARE @Mensaje nvarchar(2000)=N'" + REPLACE(@[System::ErrorDescription],"'","''") + "'; IF XACT_STATE()&lt;&gt;0 ROLLBACK; IF NOT EXISTS(SELECT 1 FROM etl.Lotes WHERE id_lote=@Lote) INSERT etl.Lotes(id_lote,modo,estado) VALUES(@Lote,'Incremental_SSIS','ERROR'); UPDATE etl.Lotes SET estado='ERROR',fecha_fin=sysdatetime(),mensaje=@Mensaje WHERE id_lote=@Lote; INSERT etl.Errores(id_lote,mensaje) VALUES(@Lote,@Mensaje); UPDATE raw.EventosSQL SET estado='RECHAZADO' WHERE id_lote=@Lote AND estado='PROCESANDO';"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7CA2D0E4-DE97-42C7-8986-6E68F81413F6}"
              SQLTask:TimeOut="60"
              SQLTask:SqlStatementSource="DECLARE @Lote uniqueidentifier='{B3EA4D44-6382-462A-8959-6932828680D9}'; DECLARE @Mensaje nvarchar(2000)=N''; IF XACT_STATE()&lt;&gt;0 ROLLBACK; IF NOT EXISTS(SELECT 1 FROM etl.Lotes WHERE id_lote=@Lote) INSERT etl.Lotes(id_lote,modo,estado) VALUES(@Lote,'Incremental_SSIS','ERROR'); UPDATE etl.Lotes SET estado='ERROR',fecha_fin=sysdatetime(),mensaje=@Mensaje WHERE id_lote=@Lote; INSERT etl.Errores(id_lote,mensaje) VALUES(@Lote,@Mensaje); UPDATE raw.EventosSQL SET estado='RECHAZADO' WHERE id_lote=@Lote AND estado='PROCESANDO';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:EventHandler>
