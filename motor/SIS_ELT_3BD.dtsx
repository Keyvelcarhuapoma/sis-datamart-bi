        DTS:DataType="8">localhost</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5A110CA9-D0F6-41E3-BF8F-AB6F7112A895}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SimularFallo">
      <DTS:VariableValue
        DTS:DataType="8">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9BC4DAA5-86F4-4741-8B3E-DE7318E09508}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_01_Iniciar_Lote_y_Bloquear">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;SET XACT_ABORT ON;
IF DB_NAME()&lt;&gt;'SIS_RAW' OR NOT EXISTS(SELECT 1 FROM etl.Proyecto WHERE nombre='SIS-3BD-v1') THROW 52003,'Base no autorizada.',1;
DECLARE @Lock int;EXEC @Lock=sys.sp_getapplock @Resource='SIS_3BD',@LockMode='Exclusive',@LockOwner='Session',@LockTimeout=0;
IF @Lock&lt;0 THROW 52004,'Otra carga 3BD esta activa.',1;
EXEC sys.sp_set_session_context @key=N'Lote',@value=@Lote;
UPDATE raw.EventosSQL SET estado='PENDIENTE',id_lote=NULL WHERE estado='PROCESANDO';
UPDATE etl.Lotes SET estado='ERROR',fecha_fin=sysdatetime(),mensaje=N'Proceso anterior interrumpido; repetir entrada.' WHERE id_lote&lt;&gt;@Lote AND estado NOT IN('EXITOSO','ERROR');
IF EXISTS(SELECT 1 FROM etl.Lotes WHERE id_lote=@Lote)
 UPDATE etl.Lotes SET estado='CARGANDO_RAW',fecha_fin=NULL,mensaje=NULL WHERE id_lote=@Lote;
ELSE
 INSERT etl.Lotes(id_lote,modo,estado,archivo) VALUES(@Lote,@Modo,'CARGANDO_RAW',@Archivo);
TRUNCATE TABLE stg.Entrada;

TRUNCATE TABLE stg.ErroresLectura;
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F905FC44-FAB7-4CB3-88D5-394D3BE2670A}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_03_Archivar_RAW_Historico">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;
IF @Modo='SNAPSHOT'
 INSERT raw.Registros(id_lote,fila_origen,fuente_tipo,[ANIO],[MES],[REGION],[PROVINCIA],[UBIGEO_DISTRITO],[DISTRITO],[COD_UNIDAD_EJECUTORA],[DESC_UNIDAD_EJECUTORA],[COD_IPRESS],[IPRESS],[NIVEL_EESS],[PLAN_SEGURO],[COD_SERVICIO],[DESC_SERVICIO],[SEXO],[GRUPO_EDAD],[ATENCIONES]) SELECT @Lote,fila_archivo,'SNAPSHOT',[ANIO],[MES],[REGION],[PROVINCIA],[UBIGEO_DISTRITO],[DISTRITO],[COD_UNIDAD_EJECUTORA],[DESC_UNIDAD_EJECUTORA],[COD_IPRESS],[IPRESS],[NIVEL_EESS],[PLAN_SEGURO],[COD_SERVICIO],[DESC_SERVICIO],[SEXO],[GRUPO_EDAD],[ATENCIONES] FROM stg.Entrada;
ELSE IF EXISTS(SELECT 1 FROM raw.Registros WHERE id_lote=@Lote AND fuente_tipo='SQL' AND estado_proceso='PENDIENTE') BEGIN
 UPDATE raw.Registros SET estado_proceso='PROCESANDO' WHERE id_lote=@Lote AND fuente_tipo='SQL' AND estado_proceso='PENDIENTE';
END ELSE BEGIN
 ;WITH e AS(SELECT TOP(1000) * FROM raw.EventosSQL WITH(UPDLOCK,READPAST) WHERE estado='PENDIENTE' ORDER BY id_evento)
 UPDATE e SET estado='PROCESANDO',id_lote=@Lote;
 INSERT raw.Registros(id_lote,fila_origen,fuente_tipo,clave_origen,version_origen,operacion,id_evento,[ANIO],[MES],[REGION],[PROVINCIA],[UBIGEO_DISTRITO],[DISTRITO],[COD_UNIDAD_EJECUTORA],[DESC_UNIDAD_EJECUTORA],[COD_IPRESS],[IPRESS],[NIVEL_EESS],[PLAN_SEGURO],[COD_SERVICIO],[DESC_SERVICIO],[SEXO],[GRUPO_EDAD],[ATENCIONES])
 SELECT @Lote,e.id_evento,'SQL',e.clave_origen,e.version,e.operacion,e.id_evento,j.[ANIO],j.[MES],j.[REGION],j.[PROVINCIA],j.[UBIGEO_DISTRITO],j.[DISTRITO],j.[COD_UNIDAD_EJECUTORA],j.[DESC_UNIDAD_EJECUTORA],j.[COD_IPRESS],j.[IPRESS],j.[NIVEL_EESS],j.[PLAN_SEGURO],j.[COD_SERVICIO],j.[DESC_SERVICIO],j.[SEXO],j.[GRUPO_EDAD],j.[ATENCIONES] FROM raw.EventosSQL e OUTER APPLY OPENJSON(e.datos) WITH([ANIO] nvarchar(1000) '$.ANIO',[MES] nvarchar(1000) '$.MES',[REGION] nvarchar(1000) '$.REGION',[PROVINCIA] nvarchar(1000) '$.PROVINCIA',[UBIGEO_DISTRITO] nvarchar(1000) '$.UBIGEO_DISTRITO',[DISTRITO] nvarchar(1000) '$.DISTRITO',[COD_UNIDAD_EJECUTORA] nvarchar(1000) '$.COD_UNIDAD_EJECUTORA',[DESC_UNIDAD_EJECUTORA] nvarchar(1000) '$.DESC_UNIDAD_EJECUTORA',[COD_IPRESS] nvarchar(1000) '$.COD_IPRESS',[IPRESS] nvarchar(1000) '$.IPRESS',[NIVEL_EESS] nvarchar(1000) '$.NIVEL_EESS',[PLAN_SEGURO] nvarchar(1000) '$.PLAN_SEGURO',[COD_SERVICIO] nvarchar(1000) '$.COD_SERVICIO',[DESC_SERVICIO] nvarchar(1000) '$.DESC_SERVICIO',[SEXO] nvarchar(1000) '$.SEXO',[GRUPO_EDAD] nvarchar(1000) '$.GRUPO_EDAD',[ATENCIONES] nvarchar(1000) '$.ATENCIONES') j WHERE e.id_lote=@Lote AND e.estado='PROCESANDO';
END;
DECLARE @N bigint=(SELECT COUNT_BIG(*) FROM raw.Registros WHERE id_lote=@Lote);

UPDATE etl.Lotes SET filas_origen=@N,estado='RAW_ARCHIVADO' WHERE id_lote=@Lote;

IF EXISTS(SELECT 1 FROM stg.ErroresLectura) BEGIN
 INSERT etl.Rechazos(id_lote,archivo,motivo) SELECT @Lote,@Archivo,CONCAT('PARSER_SSIS: ErrorCode=',ErrorCode,'; columna=',ErrorColumn,'; original completo archivado en la recepcion') FROM stg.ErroresLectura;
 UPDATE etl.Lotes SET filas_rechazadas=(SELECT COUNT_BIG(*) FROM stg.ErroresLectura),filas_origen=filas_origen+(SELECT COUNT_BIG(*) FROM stg.ErroresLectura) WHERE id_lote=@Lote;
 THROW 52012,'Errores de lectura: lote conservado, no se publica parcialmente.',1;
END;
IF @Modo='SNAPSHOT' AND (SELECT COUNT_BIG(*) FROM raw.Registros WHERE id_lote=@Lote)&lt;&gt;(SELECT COUNT_BIG(*) FROM stg.Entrada) THROW 52013,'Conteo RAW no coincide con la entrada SSIS.',1;

IF @Modo='SNAPSHOT' AND @N=0 THROW 52005,'Snapshot vacio: no autoriza borrar periodos.',1;
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{2E940977-C5B5-4CF7-9D42-3EA476650655}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_04_Validar_Contrato_y_Nulos">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON; SET XACT_ABORT ON;
TRUNCATE TABLE stg.Limpia;
INSERT etl.Rechazos SELECT @Lote,archivo,fila_archivo,motivo,anio_original,mes_original,atenciones_original FROM stg.v_Normalizada CROSS APPLY(SELECT CONCAT(CASE WHEN anio_num IS NULL OR NOT EXISTS(SELECT 1 FROM etl.AniosPermitidos y WHERE y.anio=anio_num) THEN N'ANIO_INVALIDO; ' ELSE N'' END,CASE WHEN mes_num IS NULL OR mes_num NOT BETWEEN 1 AND 12 THEN N'MES_INVALIDO; ' ELSE N'' END,CASE WHEN atenciones_num IS NULL OR atenciones_num &lt; 0 THEN N'ATENCIONES_INVALIDAS; ' ELSE N'' END,CASE WHEN CHARINDEX(NCHAR(65533),CONCAT(REGION,PROVINCIA,DISTRITO,IPRESS,DESC_SERVICIO) COLLATE Latin1_General_100_BIN2)&gt;0 THEN N'TEXTO_CON_REEMPLAZO; ' ELSE N'' END,CASE WHEN COD_IPRESS=N'NO INFORMADO' OR COD_SERVICIO=N'NO INFORMADO' THEN N'CODIGO_OBLIGATORIO_AUSENTE; ' ELSE N'' END,CASE WHEN LEN(REGION)&gt;150 OR LEN(PROVINCIA)&gt;150 OR LEN(DISTRITO)&gt;150 OR LEN(UBIGEO_DISTRITO)&gt;20 OR LEN(COD_IPRESS)&gt;50 OR LEN(COD_SERVICIO)&gt;50 OR LEN(COD_UNIDAD_EJECUTORA)&gt;50 OR LEN(NIVEL_EESS)&gt;50 OR LEN(PLAN_SEGURO)&gt;100 OR LEN(SEXO)&gt;50 OR LEN(GRUPO_EDAD)&gt;100 OR LEN(IPRESS)&gt;400 OR LEN(DESC_SERVICIO)&gt;400 OR LEN(DESC_UNIDAD_EJECUTORA)&gt;400 THEN N'LONGITUD_EXCEDIDA; ' ELSE N'' END) motivo) q WHERE motivo&lt;&gt;N'' OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT stg.Limpia([archivo],[fila_archivo],[id_raw],[clave_origen],[version_origen],[ANIO],[MES],[REGION],[PROVINCIA],[UBIGEO_DISTRITO],[DISTRITO],[COD_UNIDAD_EJECUTORA],[DESC_UNIDAD_EJECUTORA],[COD_IPRESS],[IPRESS],[NIVEL_EESS],[PLAN_SEGURO],[COD_SERVICIO],[DESC_SERVICIO],[SEXO],[GRUPO_EDAD],[ATENCIONES],[ubigeo_valido],[clave_ipress],[clave_servicio],[clave_unidad]) SELECT archivo,fila_archivo,id_raw,clave_origen,version_origen,anio_num,mes_num,[REGION],[PROVINCIA],[UBIGEO_DISTRITO],[DISTRITO],[COD_UNIDAD_EJECUTORA],[DESC_UNIDAD_EJECUTORA],[COD_IPRESS],[IPRESS],[NIVEL_EESS],[PLAN_SEGURO],[COD_SERVICIO],[DESC_SERVICIO],[SEXO],[GRUPO_EDAD],atenciones_num,CASE WHEN LEN(UBIGEO_DISTRITO)=6 AND UBIGEO_DISTRITO NOT LIKE '%[^0-9]%' AND LEFT(UBIGEO_DISTRITO,2) BETWEEN '01' AND '25' THEN 1 ELSE 0 END,HASHBYTES('SHA2_256',CONCAT([COD_IPRESS],NCHAR(31),[IPRESS],NCHAR(31),[NIVEL_EESS],NCHAR(31),[UBIGEO_DISTRITO],NCHAR(31),[DISTRITO],NCHAR(31),[PROVINCIA],NCHAR(31),[REGION],NCHAR(31),[COD_UNIDAD_EJECUTORA],NCHAR(31),[DESC_UNIDAD_EJECUTORA])),HASHBYTES('SHA2_256',CONCAT([COD_SERVICIO],NCHAR(31),[DESC_SERVICIO])),HASHBYTES('SHA2_256',CONCAT([COD_UNIDAD_EJECUTORA],NCHAR(31),[DESC_UNIDAD_EJECUTORA])) FROM stg.v_Normalizada CROSS APPLY(SELECT CONCAT(CASE WHEN anio_num IS NULL OR NOT EXISTS(SELECT 1 FROM etl.AniosPermitidos y WHERE y.anio=anio_num) THEN N'ANIO_INVALIDO; ' ELSE N'' END,CASE WHEN mes_num IS NULL OR mes_num NOT BETWEEN 1 AND 12 THEN N'MES_INVALIDO; ' ELSE N'' END,CASE WHEN atenciones_num IS NULL OR atenciones_num &lt; 0 THEN N'ATENCIONES_INVALIDAS; ' ELSE N'' END,CASE WHEN CHARINDEX(NCHAR(65533),CONCAT(REGION,PROVINCIA,DISTRITO,IPRESS,DESC_SERVICIO) COLLATE Latin1_General_100_BIN2)&gt;0 THEN N'TEXTO_CON_REEMPLAZO; ' ELSE N'' END,CASE WHEN COD_IPRESS=N'NO INFORMADO' OR COD_SERVICIO=N'NO INFORMADO' THEN N'CODIGO_OBLIGATORIO_AUSENTE; ' ELSE N'' END,CASE WHEN LEN(REGION)&gt;150 OR LEN(PROVINCIA)&gt;150 OR LEN(DISTRITO)&gt;150 OR LEN(UBIGEO_DISTRITO)&gt;20 OR LEN(COD_IPRESS)&gt;50 OR LEN(COD_SERVICIO)&gt;50 OR LEN(COD_UNIDAD_EJECUTORA)&gt;50 OR LEN(NIVEL_EESS)&gt;50 OR LEN(PLAN_SEGURO)&gt;100 OR LEN(SEXO)&gt;50 OR LEN(GRUPO_EDAD)&gt;100 OR LEN(IPRESS)&gt;400 OR LEN(DESC_SERVICIO)&gt;400 OR LEN(DESC_UNIDAD_EJECUTORA)&gt;400 THEN N'LONGITUD_EXCEDIDA; ' ELSE N'' END) motivo) q WHERE motivo=N'' OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);

IF EXISTS(SELECT 1 FROM etl.Rechazos WHERE id_lote=@Lote)
 BEGIN UPDATE etl.Lotes SET filas_aceptadas=(SELECT COUNT_BIG(*) FROM stg.Limpia),filas_rechazadas=(SELECT COUNT_BIG(*) FROM etl.Rechazos WHERE id_lote=@Lote) WHERE id_lote=@Lote;
 THROW 51302,'Snapshot invalido: se registraron rechazos. No se publica parcialmente un mes.',1; END;

IF @Modo='SQL' AND EXISTS(SELECT 1 FROM raw.Registros r JOIN SIS_NORMALIZADA.oltp.OrigenVersion v ON v.clave_origen=r.clave_origen WHERE r.id_lote=@Lote AND r.version_origen&lt;=v.version) THROW 52006,'Version SQL anterior o igual a la publicada.',1;
UPDATE etl.Lotes SET filas_aceptadas=(SELECT COUNT_BIG(*) FROM stg.Limpia),filas_rechazadas=0,estado='VALIDADO' WHERE id_lote=@Lote;

</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{BABEEECB-B19E-4D68-BF04-59A7278E6C0B}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_05_Detectar_Incremento">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;
IF @Modo='SNAPSHOT' BEGIN
 UPDATE l SET huella_fila=HASHBYTES('SHA2_256',(SELECT l.[ANIO],l.[MES],l.[REGION],l.[PROVINCIA],l.[UBIGEO_DISTRITO],l.[DISTRITO],l.[COD_UNIDAD_EJECUTORA],l.[DESC_UNIDAD_EJECUTORA],l.[COD_IPRESS],l.[IPRESS],l.[NIVEL_EESS],l.[PLAN_SEGURO],l.[COD_SERVICIO],l.[DESC_SERVICIO],l.[SEXO],l.[GRUPO_EDAD],l.[ATENCIONES] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) FROM stg.Limpia l;
 -- Merkle por 256 cubetas: conserva multiplicidad sin concatenar todo el mes en un unico valor.
 SELECT ANIO*100+MES periodo,CONVERT(varchar(64),huella_fila,2) h,COUNT_BIG(*) n INTO #H FROM stg.Limpia GROUP BY ANIO,MES,huella_fila OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
 SELECT periodo,LEFT(h,2) cubeta,HASHBYTES('SHA2_256',STRING_AGG(CONVERT(varchar(max),CONCAT(h,':',n,';')),'') WITHIN GROUP(ORDER BY h)) firma INTO #B FROM #H GROUP BY periodo,LEFT(h,2) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
 SELECT periodo,HASHBYTES('SHA2_256',STRING_AGG(CONVERT(varchar(max),CONCAT(cubeta,CONVERT(varchar(64),firma,2))),';') WITHIN GROUP(ORDER BY cubeta)) firma INTO #P FROM #B GROUP BY periodo OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
 INSERT etl.PlanParticion(id_lote,periodo,huella,filas,atenciones,accion,filas_anteriores,version_anterior)
 SELECT @Lote,n.periodo,h.firma,n.filas,n.atenciones,CASE WHEN p.periodo IS NULL THEN 'NUEVO' WHEN p.huella=h.firma AND p.filas=n.filas THEN 'SIN_CAMBIOS' ELSE 'CAMBIADO' END,COALESCE(p.filas,0),COALESCE(p.version,0)
 FROM(SELECT ANIO*100+MES periodo,COUNT_BIG(*) filas,SUM(ATENCIONES) atenciones FROM stg.Limpia GROUP BY ANIO,MES)n JOIN #P h ON h.periodo=n.periodo LEFT JOIN etl.Particiones p ON p.periodo=n.periodo;
 IF EXISTS(SELECT 1 FROM etl.PlanParticion WHERE id_lote=@Lote AND filas&lt;filas_anteriores*0.8) BEGIN
  INSERT etl.Rechazos(id_lote,archivo,motivo) SELECT @Lote,@Archivo,CONCAT('SNAPSHOT_PARCIAL: periodo ',periodo,', filas previas ',filas_anteriores,', recibidas ',filas) FROM etl.PlanParticion WHERE id_lote=@Lote AND filas&lt;filas_anteriores*0.8;
  THROW 52007,'Posible snapshot parcial: disminucion superior al 20%; requiere revision.',1;
 END;
 INSERT etl.Afectados SELECT @Lote,periodo FROM etl.PlanParticion WHERE id_lote=@Lote AND accion&lt;&gt;'SIN_CAMBIOS';
END ELSE BEGIN
 INSERT etl.Afectados SELECT @Lote,periodo FROM(
 SELECT ANIO*100+MES periodo FROM stg.Limpia
 UNION SELECT a.anio*100+a.mes FROM SIS_NORMALIZADA.oltp.Registro_Atencion a JOIN raw.Registros r ON r.clave_origen=a.clave_origen WHERE r.id_lote=@Lote AND a.fuente_tipo='SQL')p;
END;
UPDATE etl.Lotes SET estado='CAMBIOS_DETECTADOS' WHERE id_lote=@Lote;
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A8031DDF-1CF3-4ACD-B71C-1727A7F3D6AA}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_06_Normalizar_SIS_NORMALIZADA">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;SET XACT_ABORT ON;
BEGIN TRAN;
SELECT l.* INTO #Carga FROM stg.Limpia l WHERE @Modo='SQL' OR EXISTS(SELECT 1 FROM etl.Afectados a WHERE a.id_lote=@Lote AND a.periodo=l.ANIO*100+l.MES) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
IF @Modo='SNAPSHOT'
 DELETE a FROM SIS_NORMALIZADA.oltp.Registro_Atencion a JOIN etl.Afectados p ON p.id_lote=@Lote AND a.anio=p.periodo/100 AND a.mes=p.periodo%100 WHERE a.fuente_tipo='SNAPSHOT' OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
ELSE
 DELETE a FROM SIS_NORMALIZADA.oltp.Registro_Atencion a WHERE a.fuente_tipo='SQL' AND EXISTS(SELECT 1 FROM raw.Registros r WHERE r.id_lote=@Lote AND r.clave_origen=a.clave_origen) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
IF @SimularFallo=1 THROW 52008,'Fallo controlado: rollback entre las tres bases.',1;
INSERT SIS_NORMALIZADA.oltp.Region(nombre) SELECT DISTINCT REGION FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Region x WHERE x.nombre=l.REGION) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Provincia(id_region,nombre) SELECT DISTINCT r.id_region,l.PROVINCIA FROM #Carga l JOIN SIS_NORMALIZADA.oltp.Region r ON r.nombre=l.REGION WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Provincia x WHERE x.id_region=r.id_region AND x.nombre=l.PROVINCIA) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Distrito(id_provincia,ubigeo,nombre) SELECT DISTINCT p.id_provincia,l.UBIGEO_DISTRITO,l.DISTRITO FROM #Carga l JOIN SIS_NORMALIZADA.oltp.Region r ON r.nombre=l.REGION JOIN SIS_NORMALIZADA.oltp.Provincia p ON p.id_region=r.id_region AND p.nombre=l.PROVINCIA WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Distrito x WHERE x.id_provincia=p.id_provincia AND x.ubigeo=l.UBIGEO_DISTRITO AND x.nombre=l.DISTRITO) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Unidad_Ejecutora(clave_version,codigo,nombre) SELECT DISTINCT clave_unidad,COD_UNIDAD_EJECUTORA,DESC_UNIDAD_EJECUTORA FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Unidad_Ejecutora x WHERE x.clave_version=l.clave_unidad) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.IPRESS(clave_version,cod_ipress,nombre,nivel,id_distrito,id_unidad,ubigeo_valido)
SELECT DISTINCT l.clave_ipress,l.COD_IPRESS,l.IPRESS,l.NIVEL_EESS,d.id_distrito,u.id_unidad,l.ubigeo_valido
FROM #Carga l JOIN SIS_NORMALIZADA.oltp.Region r ON r.nombre=l.REGION JOIN SIS_NORMALIZADA.oltp.Provincia p ON p.id_region=r.id_region AND p.nombre=l.PROVINCIA JOIN SIS_NORMALIZADA.oltp.Distrito d ON d.id_provincia=p.id_provincia AND d.ubigeo=l.UBIGEO_DISTRITO AND d.nombre=l.DISTRITO JOIN SIS_NORMALIZADA.oltp.Unidad_Ejecutora u ON u.clave_version=l.clave_unidad WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.IPRESS x WHERE x.clave_version=l.clave_ipress) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Servicio(clave_version,codigo,descripcion) SELECT DISTINCT clave_servicio,COD_SERVICIO,DESC_SERVICIO FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Servicio x WHERE x.clave_version=l.clave_servicio) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Plan_Seguro(nombre) SELECT DISTINCT PLAN_SEGURO FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Plan_Seguro x WHERE x.nombre=l.PLAN_SEGURO) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Sexo(nombre) SELECT DISTINCT SEXO FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Sexo x WHERE x.nombre=l.SEXO) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_NORMALIZADA.oltp.Grupo_Edad(nombre) SELECT DISTINCT GRUPO_EDAD FROM #Carga l WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.Grupo_Edad x WHERE x.nombre=l.GRUPO_EDAD) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);

INSERT SIS_NORMALIZADA.oltp.Registro_Atencion(archivo,fila_archivo,anio,mes,id_ipress,id_servicio,id_plan,id_sexo,id_grupo_edad,cantidad_atenciones,fuente_tipo,clave_origen,version_origen,id_raw)
SELECT l.archivo,l.fila_archivo,l.ANIO,l.MES,i.id_ipress,s.id_servicio,p.id_plan,x.id_sexo,g.id_grupo_edad,l.ATENCIONES,@Modo,l.clave_origen,l.version_origen,l.id_raw
FROM #Carga l JOIN SIS_NORMALIZADA.oltp.IPRESS i ON i.clave_version=l.clave_ipress JOIN SIS_NORMALIZADA.oltp.Servicio s ON s.clave_version=l.clave_servicio JOIN SIS_NORMALIZADA.oltp.Plan_Seguro p ON p.nombre=l.PLAN_SEGURO JOIN SIS_NORMALIZADA.oltp.Sexo x ON x.nombre=l.SEXO JOIN SIS_NORMALIZADA.oltp.Grupo_Edad g ON g.nombre=l.GRUPO_EDAD OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
IF @Modo='SQL' BEGIN
 SELECT clave_origen,MAX(version_origen) version INTO #V FROM raw.Registros WHERE id_lote=@Lote GROUP BY clave_origen;
 UPDATE v SET version=n.version,eliminado=CASE WHEN r.operacion='D' THEN 1 ELSE 0 END FROM SIS_NORMALIZADA.oltp.OrigenVersion v JOIN #V n ON n.clave_origen=v.clave_origen JOIN raw.Registros r ON r.id_lote=@Lote AND r.clave_origen=n.clave_origen AND r.version_origen=n.version;
 INSERT SIS_NORMALIZADA.oltp.OrigenVersion SELECT n.clave_origen,n.version,CASE WHEN r.operacion='D' THEN 1 ELSE 0 END FROM #V n JOIN raw.Registros r ON r.id_lote=@Lote AND r.clave_origen=n.clave_origen AND r.version_origen=n.version WHERE NOT EXISTS(SELECT 1 FROM SIS_NORMALIZADA.oltp.OrigenVersion v WHERE v.clave_origen=n.clave_origen);
END;
DROP TABLE #Carga;
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E33E1C11-A1D6-49FF-B990-BDA2841528A2}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_07_Publicar_SIS_DIMENSIONAL">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;
SELECT a.* INTO #Nuevos FROM SIS_NORMALIZADA.oltp.Registro_Atencion a JOIN etl.Afectados p ON p.id_lote=@Lote AND a.anio=p.periodo/100 AND a.mes=p.periodo%100 OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Dim_Tiempo(anio,numero_mes,mes,trimestre,semestre,periodo_codigo)
SELECT DISTINCT anio,mes,CHOOSE(mes,N'Enero',N'Febrero',N'Marzo',N'Abril',N'Mayo',N'Junio',N'Julio',N'Agosto',N'Septiembre',N'Octubre',N'Noviembre',N'Diciembre'),(mes-1)/3+1,CASE WHEN mes&lt;=6 THEN 1 ELSE 2 END,anio*100+mes FROM #Nuevos a WHERE NOT EXISTS(SELECT 1 FROM SIS_DIMENSIONAL.dm.Dim_Tiempo x WHERE x.anio=a.anio AND x.numero_mes=a.mes) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Dim_IPRESS(id_ipress_oltp,cod_ipress,nombre_ipress,nivel_eess,ubigeo_distrito,distrito,provincia,region,cod_unidad_ejecutora,desc_unidad_ejecutora,ubigeo_valido)
SELECT i.id_ipress,i.cod_ipress,i.nombre,i.nivel,d.ubigeo,d.nombre,p.nombre,r.nombre,u.codigo,u.nombre,i.ubigeo_valido FROM SIS_NORMALIZADA.oltp.IPRESS i JOIN SIS_NORMALIZADA.oltp.Distrito d ON i.id_distrito=d.id_distrito JOIN SIS_NORMALIZADA.oltp.Provincia p ON d.id_provincia=p.id_provincia JOIN SIS_NORMALIZADA.oltp.Region r ON p.id_region=r.id_region JOIN SIS_NORMALIZADA.oltp.Unidad_Ejecutora u ON i.id_unidad=u.id_unidad WHERE NOT EXISTS(SELECT 1 FROM SIS_DIMENSIONAL.dm.Dim_IPRESS x WHERE x.id_ipress_oltp=i.id_ipress) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Dim_Servicio(id_servicio_oltp,cod_servicio,desc_servicio) SELECT id_servicio,codigo,descripcion FROM SIS_NORMALIZADA.oltp.Servicio s WHERE NOT EXISTS(SELECT 1 FROM SIS_DIMENSIONAL.dm.Dim_Servicio x WHERE x.id_servicio_oltp=s.id_servicio) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Dim_Seguro(id_plan_oltp,plan_seguro) SELECT id_plan,nombre FROM SIS_NORMALIZADA.oltp.Plan_Seguro s WHERE NOT EXISTS(SELECT 1 FROM SIS_DIMENSIONAL.dm.Dim_Seguro x WHERE x.id_plan_oltp=s.id_plan) OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Dim_Demografia(sexo,grupo_edad) SELECT DISTINCT s.nombre,g.nombre FROM #Nuevos a JOIN SIS_NORMALIZADA.oltp.Sexo s ON a.id_sexo=s.id_sexo JOIN SIS_NORMALIZADA.oltp.Grupo_Edad g ON a.id_grupo_edad=g.id_grupo_edad WHERE NOT EXISTS(SELECT 1 FROM SIS_DIMENSIONAL.dm.Dim_Demografia x WHERE x.sexo=s.nombre AND x.grupo_edad=g.nombre) OPTION(MAXDOP 1, MAX_GRANT_PERCENT=1);

DELETE f FROM SIS_DIMENSIONAL.dm.Fact_Atenciones f JOIN SIS_DIMENSIONAL.dm.Dim_Tiempo t ON t.id_tiempo_sk=f.id_tiempo_sk JOIN etl.Afectados p ON p.id_lote=@Lote AND p.periodo=t.periodo_codigo OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT SIS_DIMENSIONAL.dm.Fact_Atenciones(id_tiempo_sk,id_ipress_sk,id_servicio_sk,id_seguro_sk,id_demografia_sk,cantidad_atenciones,filas_origen,id_lote)
SELECT t.id_tiempo_sk,i.id_ipress_sk,s.id_servicio_sk,p.id_seguro_sk,d.id_demografia_sk,SUM(a.cantidad_atenciones),COUNT_BIG(*),@Lote
FROM #Nuevos a JOIN SIS_DIMENSIONAL.dm.Dim_Tiempo t ON t.anio=a.anio AND t.numero_mes=a.mes JOIN SIS_DIMENSIONAL.dm.Dim_IPRESS i ON i.id_ipress_oltp=a.id_ipress JOIN SIS_DIMENSIONAL.dm.Dim_Servicio s ON s.id_servicio_oltp=a.id_servicio JOIN SIS_DIMENSIONAL.dm.Dim_Seguro p ON p.id_plan_oltp=a.id_plan JOIN SIS_NORMALIZADA.oltp.Sexo x ON x.id_sexo=a.id_sexo JOIN SIS_NORMALIZADA.oltp.Grupo_Edad g ON g.id_grupo_edad=a.id_grupo_edad JOIN SIS_DIMENSIONAL.dm.Dim_Demografia d ON d.sexo=x.nombre AND d.grupo_edad=g.nombre
GROUP BY t.id_tiempo_sk,i.id_ipress_sk,s.id_servicio_sk,p.id_seguro_sk,d.id_demografia_sk OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
DROP TABLE #Nuevos;
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1FD8CE4F-70DB-4FA1-B6E8-81181F283008}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_08_Conciliar_y_Confirmar">
      <DTS:VariableValue
        DTS:DataType="8">SET NOCOUNT ON;
INSERT etl.Validaciones(id_lote,control,esperado,obtenido,cumple)
SELECT @Lote,CONCAT('ATENCIONES_',p.periodo),COALESCE(n.cantidad,0),COALESCE(d.cantidad,0),CASE WHEN COALESCE(n.cantidad,0)=COALESCE(d.cantidad,0) THEN 1 ELSE 0 END FROM etl.Afectados p
OUTER APPLY(SELECT SUM(cantidad_atenciones) cantidad FROM SIS_NORMALIZADA.oltp.Registro_Atencion WHERE anio=p.periodo/100 AND mes=p.periodo%100)n
OUTER APPLY(SELECT SUM(f.cantidad_atenciones) cantidad FROM SIS_DIMENSIONAL.dm.Fact_Atenciones f JOIN SIS_DIMENSIONAL.dm.Dim_Tiempo t ON t.id_tiempo_sk=f.id_tiempo_sk WHERE t.periodo_codigo=p.periodo)d WHERE p.id_lote=@Lote OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
INSERT etl.Validaciones(id_lote,control,esperado,obtenido,cumple)
SELECT @Lote,CONCAT('LINAJE_FILAS_',p.periodo),COALESCE(n.filas,0),COALESCE(d.filas,0),CASE WHEN COALESCE(n.filas,0)=COALESCE(d.filas,0) THEN 1 ELSE 0 END FROM etl.Afectados p
OUTER APPLY(SELECT COUNT_BIG(*) filas FROM SIS_NORMALIZADA.oltp.Registro_Atencion WHERE anio=p.periodo/100 AND mes=p.periodo%100)n
OUTER APPLY(SELECT SUM(f.filas_origen) filas FROM SIS_DIMENSIONAL.dm.Fact_Atenciones f JOIN SIS_DIMENSIONAL.dm.Dim_Tiempo t ON t.id_tiempo_sk=f.id_tiempo_sk WHERE t.periodo_codigo=p.periodo)d WHERE p.id_lote=@Lote OPTION(MAXDOP 1,MAX_GRANT_PERCENT=1);
IF EXISTS(SELECT 1 FROM etl.Validaciones WHERE id_lote=@Lote AND cumple=0) THROW 52009,'Conciliacion fallida; rollback.',1;
INSERT etl.Publicaciones SELECT @Lote,periodo,version_anterior+1,huella,filas_anteriores,filas,atenciones,sysdatetime() FROM etl.PlanParticion WHERE id_lote=@Lote AND accion&lt;&gt;'SIN_CAMBIOS';
UPDATE p SET huella=n.huella,filas=n.filas,atenciones=n.atenciones,version=n.version_anterior+1,id_lote=@Lote,actualizado=sysdatetime() FROM etl.Particiones p JOIN etl.PlanParticion n ON n.periodo=p.periodo WHERE n.id_lote=@Lote AND n.accion='CAMBIADO';
INSERT etl.Particiones(periodo,huella,filas,atenciones,version,id_lote) SELECT periodo,huella,filas,atenciones,1,@Lote FROM etl.PlanParticion WHERE id_lote=@Lote AND accion='NUEVO';
IF EXISTS(SELECT 1 FROM etl.Afectados WHERE id_lote=@Lote) UPDATE SIS_DIMENSIONAL.dm.Publicacion SET version=version+1,id_lote=@Lote,fecha=sysdatetime() WHERE id=1;
UPDATE raw.EventosSQL SET estado='PUBLICADO' WHERE id_lote=@Lote AND estado='PROCESANDO';
UPDATE raw.Registros SET estado_proceso='PUBLICADO' WHERE id_lote=@Lote AND fuente_tipo='SQL' AND estado_proceso='PROCESANDO';
-- En SQL se confirman eventos (incluidas bajas/versiones superadas), no filas finales del hecho.
IF @Modo='SQL' UPDATE etl.Lotes SET filas_aceptadas=filas_origen WHERE id_lote=@Lote;
UPDATE etl.Lotes SET estado='EXITOSO',fecha_fin=sysdatetime(),filas_dm=(SELECT COUNT_BIG(*) FROM SIS_DIMENSIONAL.dm.Fact_Atenciones),atenciones_dm=(SELECT COALESCE(SUM(cantidad_atenciones),0) FROM SIS_DIMENSIONAL.dm.Fact_Atenciones),mensaje=CONCAT('Periodos afectados: ',(SELECT COUNT(*) FROM etl.Afectados WHERE id_lote=@Lote)) WHERE id_lote=@Lote;
COMMIT;
EXEC sys.sp_releaseapplock @Resource='SIS_3BD',@LockOwner='Session';
</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01_Iniciar_Lote_y_Bloquear"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{5B3DFAFF-5B05-46E0-921C-6F91AE2633D2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01_Iniciar_Lote_y_Bloquear"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @Lote uniqueidentifier = '" + @[User::IdLote] + "'; DECLARE @Esperadas bigint = " + @[User::FilasEsperadas] + "; DECLARE @SimularFallo int = " + @[User::SimularFallo] + "; " + " DECLARE @Modo varchar(20)='" + @[User::Modo] + "'; DECLARE @Archivo nvarchar(1000)=N'" + REPLACE(@[User::Archivo_Entrada],"'","''") + "'; " + @[User::SQL_01_Iniciar_Lote_y_Bloquear]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7CA2D0E4-DE97-42C7-8986-6E68F81413F6}"
          SQLTask:SqlStatementSource="DECLARE @Lote uniqueidentifier = '{B3EA4D44-6382-462A-8959-6932828680D9}'; DECLARE @Esperadas bigint = 40000; DECLARE @SimularFallo int = 0;  DECLARE @Modo varchar(20)='SNAPSHOT'; DECLARE @Archivo nvarchar(1000)=N'.\motor\fuentes\entrada.csv'; SET NOCOUNT ON;SET XACT_ABORT ON;&#xA;IF DB_NAME()&lt;&gt;'SIS_RAW' OR NOT EXISTS(SELECT 1 FROM etl.Proyecto WHERE nombre='SIS-3BD-v1') THROW 52003,'Base no autorizada.',1;&#xA;DECLARE @Lock int;EXEC @Lock=sys.sp_getapplock @Resource='SIS_3BD',@LockMode='Exclusive',@LockOwner='Session',@LockTimeout=0;&#xA;IF @Lock&lt;0 THROW 52004,'Otra carga 3BD esta activa.',1;&#xA;EXEC sys.sp_set_session_context @key=N'Lote',@value=@Lote;&#xA;UPDATE raw.EventosSQL SET estado='PENDIENTE',id_lote=NULL WHERE estado='PROCESANDO';&#xA;UPDATE etl.Lotes SET estado='ERROR',fecha_fin=sysdatetime(),mensaje=N'Proceso anterior interrumpido; repetir entrada.' WHERE id_lote&lt;&gt;@Lote AND estado NOT IN('EXITOSO','ERROR');&#xA;IF EXISTS(SELECT 1 FROM etl.Lotes WHERE id_lote=@Lote)&#xA; UPDATE etl.Lotes SET estado='CARGANDO_RAW',fecha_fin=NULL,mensaje=NULL WHERE id_lote=@Lote;&#xA;ELSE&#xA; INSERT etl.Lotes(id_lote,modo,estado,archivo) VALUES(@Lote,@Modo,'CARGANDO_RAW',@Archivo);&#xA;TRUNCATE TABLE stg.Entrada;&#xA;&#xA;TRUNCATE TABLE stg.ErroresLectura;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
